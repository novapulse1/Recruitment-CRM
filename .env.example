# =============================================================================
# NovaPulse CRM - Production Environment Configuration
# Add these variables to your Vercel Project Settings (or local .env file)
# =============================================================================

# Firebase Web App Credentials (Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=novapulse-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=novapulse-crm
VITE_FIREBASE_STORAGE_BUCKET=novapulse-crm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Developer Mode (Set to true only for local sandbox testing)
VITE_DEV_MODE=false
